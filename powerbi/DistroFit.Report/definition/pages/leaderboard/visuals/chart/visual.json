{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "leaderboard_chart",
  "position": {
    "x": 24,
    "y": 540,
    "z": 0,
    "width": 1100,
    "height": 330,
    "tabOrder": 540.0024
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_distribution"
                    }
                  },
                  "Property": "distribution_name"
                }
              },
              "queryRef": "dim_distribution.distribution_name",
              "nativeQueryRef": "distribution_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "AIC Delta"
                }
              },
              "queryRef": "_Measures.AIC Delta",
              "nativeQueryRef": "AIC Delta"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'AIC Delta by curve'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
